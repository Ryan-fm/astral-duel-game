# Server-only. A shared Free Tier is supported; never prefix secrets with VITE_.
# A Vercel integration with prefix DUEL injects DUEL_KV_REST_API_URL / TOKEN.
# Standard Upstash names below are also supported. Supply one complete pair.
UPSTASH_REDIS_REST_URL=https://YOUR-DUEL-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=SET_IN_VERCEL_ENVIRONMENT_VARIABLES
DUEL_REDIS_SHARED=1
DUEL_REDIS_NAMESPACE=astral-duel:prod:v1
# Use astral-duel:preview:v1 in preview; never use another game's namespace.
DUEL_ONLINE_ENABLED=1
DUEL_POLL_MS=1500
DUEL_IDLE_POLL_MS=10000
DUEL_ALLOWED_ORIGINS=https://www.bilibilitoy.com,https://bilibilitoy.com,https://www.bilibili.com
DUEL_SOCKET_PATH=/api/duel/socket.io
# Optional authenticated deadline reconciliation endpoint for an external scheduler.
DUEL_TICK_SECRET=SET_A_RANDOM_SERVER_ONLY_SECRET

# Toy build only. These are public endpoint values, never credentials.
VITE_DUEL_SERVER_URL=https://YOUR-DUEL-PROJECT.vercel.app
VITE_DUEL_SOCKET_PATH=/api/duel/socket.io
VITE_DUEL_ONLINE_ENABLED=1
# No-Redis fallback: build:solo / build:toy:solo, DUEL_ONLINE_ENABLED=0.
# Those builds use the browser rule engine and never attempt a PK connection.
