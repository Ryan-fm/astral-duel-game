{
  "name": "mobile-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "dev:game": "node server/index.mjs",
    "build:game": "npm run check:runtime && tsc && vite build --config game.vite.config.ts",
    "start:game": "NODE_ENV=production node server/index.mjs",
    "test:game": "node --test server/engine.test.mjs server/network.test.mjs server/gacha.test.mjs server/offline.test.mjs server/battle-ui.test.mjs server/card-drop.test.mjs server/monster-models.test.mjs",
    "build:toy": "npm run check:runtime && tsc && vite build --config toy.vite.config.ts && node scripts/prepare-toy-build.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "express": "^5.2.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/express": "^5.0.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
